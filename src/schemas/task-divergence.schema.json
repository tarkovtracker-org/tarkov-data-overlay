{
  "$id": "task-divergence.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {
    "additionalProperties": false,
    "properties": {
      "fields": {
        "additionalProperties": {
          "additionalProperties": false,
          "properties": {
            "confidence": {
              "enum": ["high", "medium", "low"]
            },
            "note": {
              "type": "string"
            },
            "pve": {
              "type": ["number", "string", "boolean", "null"]
            },
            "pveSource": {
              "enum": ["wiki", "tarkov.dev", "in-game"]
            },
            "pvp-season": {
              "type": ["number", "string", "boolean", "null"]
            },
            "pvpSeasonSource": {
              "enum": ["wiki", "tarkov.dev", "in-game"]
            },
            "regular": {
              "type": ["number", "string", "boolean", "null"]
            },
            "regularSource": {
              "enum": ["wiki", "tarkov.dev", "in-game"]
            },
            "verified": {
              "description": "Coarse reference to the data the values were last verified against (e.g. 1.1-pve); dates are deliberately not recorded.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$",
              "type": "string"
            }
          },
          "required": ["confidence", "verified"],
          "anyOf": [
            { "required": ["regular"] },
            { "required": ["pve"] },
            { "required": ["pvp-season"] }
          ],
          "type": "object"
        },
        "minProperties": 1,
        "type": "object"
      },
      "name": {
        "type": "string"
      },
      "note": {
        "type": "string"
      },
      "proof": {
        "format": "uri",
        "type": "string"
      },
      "status": {
        "enum": ["divergent", "converged", "mode-exclusive"]
      }
    },
    "required": ["name", "proof", "status", "fields"],
    "type": "object"
  },
  "type": "object"
}
