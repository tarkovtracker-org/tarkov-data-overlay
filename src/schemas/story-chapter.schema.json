{
  "$id": "story-chapter.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Story Chapter",
  "description": "Schema for story chapter data in tarkov-data-overlay",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": [
      "id",
      "name",
      "normalizedName",
      "wikiLink",
      "order",
      "chapterQuestId",
      "referenceCoverage"
    ],
    "properties": {
      "id": {
        "description": "Unique identifier for the story chapter",
        "type": "string"
      },
      "name": {
        "description": "Display name of the story chapter",
        "type": "string"
      },
      "normalizedName": {
        "description": "URL-friendly normalized name",
        "type": "string"
      },
      "wikiLink": {
        "description": "Link to the official wiki page",
        "type": "string"
      },
      "order": {
        "description": "Sequential display order (1-based)",
        "type": "integer",
        "minimum": 1
      },
      "chapterQuestId": {
        "description": "tarkov.dev/EFT story quest id this chapter maps to (the narrator-trader Completion quest). Traceability to the source game data.",
        "type": "string",
        "pattern": "^[0-9a-f]{24}$"
      },
      "referenceCoverage": {
        "description": "How much of the chapter the pinned reference capture resolved. The client only returns a story sub-quest template once the player has reached it, so `partial: true` means the objective list is a projection of the capture, not the complete chapter, and a missing objective is not evidence that none exists.",
        "type": "object",
        "required": ["referencedSubquests", "resolvedSubquests", "partial"],
        "properties": {
          "referencedSubquests": {
            "description": "Distinct sub-quests the chapter quest references",
            "type": "integer",
            "minimum": 0
          },
          "resolvedSubquests": {
            "description": "Referenced sub-quests whose templates the capture resolved",
            "type": "integer",
            "minimum": 0
          },
          "partial": {
            "description": "True when resolvedSubquests < referencedSubquests",
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "mutuallyExclusiveQuestPairs": {
        "description": "Unordered pairs of resolved chapter sub-quest IDs that cannot both be completed. Each pair is emitted once in ID order. Partial objective progress on both quests is allowed; do not apply these as objective exclusions.",
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9a-f]{24}$" }
        }
      },
      "endings": {
        "description": "Endings this chapter branches into, restated from the client's ending_list so the whole branch set is visible without scanning objectives. Present only on a chapter whose quest references ending gate sub-quests.",
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "systemName", "gateQuestId", "objectiveCount", "resolvedInReference"],
          "properties": {
            "id": {
              "description": "Real ending id from client/ending_list. Closed on purpose: a new ending shipped by the game must be added here deliberately (see STORY_ENDINGS in src/lib/types.ts, which tests keep in sync with this enum).",
              "type": "string",
              "enum": [
                "68a6e8f1a7455e5e23099ad8",
                "68a6e8c834a37e244710d516",
                "68a6e8e4a8d0bee0b5324d96",
                "68a6028ef4c23ebbbc49da4b"
              ]
            },
            "systemName": {
              "description": "The client's own name for the ending",
              "type": "string"
            },
            "gateQuestId": {
              "description": "Sub-quest whose completion gates this ending (the ending record's only Quest condition)",
              "type": "string",
              "pattern": "^[0-9a-f]{24}$"
            },
            "objectiveCount": {
              "description": "Objectives in this chapter attributed to the gate sub-quest; 0 means the capture proves no objective-level evidence for this branch",
              "type": "integer",
              "minimum": 0
            },
            "resolvedInReference": {
              "description": "Whether the pinned reference resolved the gate sub-quest's template",
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "autoStart": {
        "description": "Whether the chapter starts automatically (true) or must be discovered in-world (false)",
        "type": "boolean"
      },
      "chapterRequirements": {
        "description": "Story chapters that must be completed before this one becomes available",
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "name"],
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "activation": {
        "description": "How this chapter is activated in-world",
        "type": "object",
        "required": ["summary"],
        "properties": {
          "summary": {
            "description": "Short activation summary",
            "type": "string"
          },
          "locations": {
            "description": "Optional map/location hints for activation",
            "type": "array",
            "items": {
              "type": "object",
              "required": ["map", "detail"],
              "properties": {
                "map": { "type": "string" },
                "detail": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "mapUnlocks": {
        "description": "Maps unlocked by completing this chapter (tarkov.dev map IDs)",
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "name"],
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "traderUnlocks": {
        "description": "Traders unlocked by progressing through this chapter (tarkov.dev trader IDs)",
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "name"],
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "questUnlocks": {
        "description": "Quests unlocked by progressing through this chapter (tarkov.dev task IDs). Consumers treat these as an alternative unlock path to the quest's taskRequirements.",
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "name"],
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "description": {
        "description": "Brief description or guidance for the chapter",
        "type": ["string", "null"]
      },
      "notes": {
        "description": "Additional notes (reputation consequences, tips, etc.)",
        "type": ["string", "null"]
      },
      "objectives": {
        "description": "Ordered list of chapter objectives",
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "type", "description", "sourceQuestId"],
          "properties": {
            "id": {
              "description": "Objective ID: the stable source objective id from the client (24-hex). Every chapter is generated from the quest reference, so fabricated positional ids are not accepted.",
              "type": "string",
              "pattern": "^[0-9a-f]{24}$"
            },
            "sourceQuestId": {
              "description": "EFT sub-quest id backing this objective (traceability to source game data)",
              "type": "string",
              "pattern": "^[0-9a-f]{24}$"
            },
            "type": {
              "description": "Whether the objective is required or bonus",
              "type": "string",
              "enum": ["main", "optional"]
            },
            "description": {
              "description": "Human-readable objective text",
              "type": "string"
            },
            "maps": {
              "description": "Task-style map references for storyline objective filtering and map display",
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "name"],
                "properties": {
                  "id": { "type": "string" },
                  "name": { "type": "string" }
                },
                "additionalProperties": false
              }
            },
            "notes": {
              "description": "Optional guidance or tips for this objective",
              "type": ["string", "null"]
            },
            "mutuallyExclusiveWith": {
              "description": "Real objective IDs (24-hex) that are mutually exclusive with this objective",
              "type": "array",
              "items": { "type": "string", "pattern": "^[0-9a-f]{24}$" }
            },
            "count": {
              "description": "Item or action count for the objective",
              "type": "integer",
              "minimum": 1
            },
            "foundInRaid": {
              "description": "Whether any item hand-in must be found in raid",
              "type": "boolean"
            },
            "item": {
              "description": "Primary item for a hand-in or collection objective",
              "type": "object",
              "required": ["id", "name"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "shortName": { "type": "string" }
              },
              "additionalProperties": false
            },
            "items": {
              "description": "Accepted items for a hand-in or collection objective",
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "name"],
                "properties": {
                  "id": { "type": "string" },
                  "name": { "type": "string" },
                  "shortName": { "type": "string" }
                },
                "additionalProperties": false
              }
            },
            "markerItem": {
              "description": "Marker or tool item needed to complete the objective on-map",
              "type": "object",
              "required": ["id", "name"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "shortName": { "type": "string" }
              },
              "additionalProperties": false
            },
            "questItem": {
              "description": "Quest item tied to a map pickup objective",
              "type": "object",
              "required": ["id", "name"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "shortName": { "type": "string" }
              },
              "additionalProperties": false
            },
            "requiredKeys": {
              "description": "Task-style key groups required to access the objective location",
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "name"],
                  "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "shortName": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              }
            },
            "zones": {
              "description": "Task-style objective zones with outlines or center points for map markers",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "map": {
                    "type": "object",
                    "required": ["id", "name"],
                    "properties": {
                      "id": { "type": "string" },
                      "name": { "type": "string" }
                    },
                    "additionalProperties": false
                  },
                  "outline": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["x", "z"],
                      "properties": {
                        "x": { "type": "number" },
                        "y": { "type": "number" },
                        "z": { "type": "number" }
                      },
                      "additionalProperties": false
                    }
                  },
                  "position": {
                    "type": "object",
                    "required": ["x", "z"],
                    "properties": {
                      "x": { "type": "number" },
                      "y": { "type": "number" },
                      "z": { "type": "number" }
                    },
                    "additionalProperties": false
                  },
                  "top": { "type": "number" },
                  "bottom": { "type": "number" }
                },
                "required": ["map"],
                "additionalProperties": false,
                "anyOf": [{ "required": ["outline"] }, { "required": ["position"] }]
              }
            },
            "possibleLocations": {
              "description": "Task-style point clusters for pickup, visit, or use-objective markers",
              "type": "array",
              "items": {
                "type": "object",
                "required": ["map", "positions"],
                "properties": {
                  "map": {
                    "type": "object",
                    "required": ["id", "name"],
                    "properties": {
                      "id": { "type": "string" },
                      "name": { "type": "string" }
                    },
                    "additionalProperties": false
                  },
                  "positions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["x", "z"],
                      "properties": {
                        "x": { "type": "number" },
                        "y": { "type": "number" },
                        "z": { "type": "number" }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "endingId": {
              "description": "Ending this objective is tied to, as the real ending id from client/ending_list (the objective belongs to that ending's gate sub-quest). Slugs (savior/survivor/fallen/debtor) are not used: consumers align endings by id. Values must be one of the ids the chapter declares in `endings`.",
              "type": "string",
              "enum": [
                "68a6e8f1a7455e5e23099ad8",
                "68a6e8c834a37e244710d516",
                "68a6e8e4a8d0bee0b5324d96",
                "68a6028ef4c23ebbbc49da4b"
              ]
            },
            "unlocks": {
              "description": "Unlocks tied to objective completion",
              "type": "array",
              "items": {
                "type": "object",
                "required": ["type", "name"],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["achievement", "barter", "map", "quest", "trader", "other"]
                  },
                  "id": { "type": "string" },
                  "name": { "type": "string" },
                  "note": { "type": "string" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "rewards": {
        "description": "Reward summary for completing the chapter",
        "type": ["object", "null"],
        "properties": {
          "description": {
            "description": "Human-readable reward description",
            "type": "string"
          }
        },
        "required": ["description"],
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  }
}
