    objectives: {
      '6848116061809d65b8503617': {
        exitStatus: ['Survived'], // Was: ["ExpBonusmarathon Name"]
      },
    },
    finishRewards: {
      traderStanding: [
        {
          trader: { name: 'Ragman' },
          standing: 0.1, // Was: 0.01
        },
      ],
    },
  },

