    objectives: {
      '63a5cf262964a7488f5243d1': {
        description: 'Eliminate PMC operatives while using an MP5SD on Streets of Tarkov, Ground Zero or Interchange', // Was (PvE): "Eliminate PMC operatives with an MP5SD on Woods, Ground Zero, Interchange, or Customs"
