# Example GitHub Actions workflow for automated override validation
#
# To enable:
#   1. Rename this file to check-overrides.yml
#   2. Commit and push to your repository
#
# This workflow runs weekly to check if overrides are still needed

name: Check Overrides

on:
  schedule:
    # Run every Monday at 9:00 AM UTC
    - cron: '0 9 * * 1'
  workflow_dispatch: # Allow manual triggering

jobs:
  validate-overrides:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      issues: write

    steps:
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - name: Setup Node.js
        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          node-version: '24'
          cache: 'npm'

      - name: Install dependencies
        run: npm ci

      - name: Check overrides
        id: check
        # This scheduled job is the right home for --fail-on-upstream: an upstream
        # data-quality regression cannot be fixed from this repository, so it must
        # not gate pull requests (CI deliberately omits the flag). Here it only
        # sets an output that decides whether an issue gets opened.
        #
        # `|| status=$?` captures the code and keeps the step green so the
        # issue-creation step still runs. Do not use `|| true` here: it makes
        # `true` the last command, so both `$?` and `PIPESTATUS[0]` become 0 and
        # every failure looks like a pass. 3 = stale overlay data, 4 = upstream
        # regression (see the exit-code table in README.md).
        #
        # Only 3 and 4 are "reportable"; anything else nonzero (1 = network,
        # parse or unexpected error, 2 = overlay inconsistency) means the check
        # could not do its job or found something the issue step does not
        # describe, so the job fails loudly rather than passing silently.
        run: |
          status=0
          npm run check-overrides -- --fail-on-stale --fail-on-upstream \
            > check-output.txt 2>&1 || status=$?
          cat check-output.txt
          echo "status=$status" >> "$GITHUB_OUTPUT"
          case "$status" in
            0 | 3 | 4) ;;
            *) exit "$status" ;;
          esac

      - name: Report validation findings
        uses: actions/github-script@ed597411d8f924073f98dfc5c65a23a2325f34cd # v8.0.0
        # Runs for a stale overlay (3) or an upstream regression (4). The previous
        # `contains(steps.check.outputs.stdout, ...)` condition never fired: `run`
        # steps have no `stdout` output, and the upstream diagnostic does not
        # contain the string it looked for.
        if: steps.check.outputs.status == '3' || steps.check.outputs.status == '4'
        env:
          VALIDATION_STATUS: ${{ steps.check.outputs.status }}
        with:
          script: |
            const fs = require('fs');
            const output = fs.readFileSync('check-output.txt', 'utf8');

            const upstream = process.env.VALIDATION_STATUS === '4';
            const label = upstream ? 'upstream-validation' : 'override-validation';
            const title = upstream
              ? '⚠️ Upstream task data regression detected'
              : '🔄 Overlay overrides may need updating';
            const description = upstream
              ? 'The automated check found an upstream data-quality regression. Report the affected modes and missing-ID counts to tarkov.dev; inspect the live task endpoints for those modes to identify the affected tasks. Stale overlay findings, if also present, are listed separately in the output.'
              : 'The automated check found obsolete overlay data. Review the affected source files and remove or scope the entries identified in the output.';

            // Provision labels when this example is enabled in a fresh repository.
            for (const name of [label, 'maintenance']) {
              try {
                await github.rest.issues.getLabel({ ...context.repo, name });
              } catch (error) {
                if (error.status !== 404) throw error;
                await github.rest.issues.createLabel({ ...context.repo, name, color: 'FBCA04' });
              }
            }

            // Each finding type has its own deduplication label.
            const issues = await github.rest.issues.listForRepo({
              owner: context.repo.owner,
              repo: context.repo.repo,
              state: 'open',
              labels: label
            });

            if (issues.data.length === 0) {
              await github.rest.issues.create({
                owner: context.repo.owner,
                repo: context.repo.repo,
                title,
                labels: [label, 'maintenance'],
                body: `${description}\n\n<details>\n<summary>Validation Output</summary>\n\n\`\`\`\n${output}\n\`\`\`\n\n</details>\n\nRun \`npm run check-overrides\` locally to see the full report.`
              });
            }
